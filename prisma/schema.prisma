generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  audits    Audit[]
}

model Audit {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())

  userId          String?
  user            User?    @relation(fields: [userId], references: [id])

  url             String
  businessType    String
  mainGoal        String
  audienceType    String
  contexts        String[]

  overallScore    Int?
  trustScore      Int?
  messagingScore  Int?
  conversionScore Int?
  uxScore         Int?
  authorityScore  Int?

  insightText     String?  @db.Text
  analyzedItems   String[]
  improvements    Json?

  status          String   @default("pending")
  errorMessage    String?
}
